{
  "info": {
    "_postman_id": "nexus-api-final-collection",
    "name": "Nexus API - Final Integration Testing",
    "description": "Comprehensive API collection for Nexus Investor-Entrepreneur Collaboration Platform. This collection includes authentication flows, user management, and role-based access testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public Endpoints",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/public/health",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "health"]
            },
            "description": "Check if the Nexus backend service is running and healthy"
          },
          "response": []
        },
        {
          "name": "Public Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/public/test",
              "host": ["{{base_url}}"],
              "path": ["api", "public", "test"]
