# Nexus Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password_here
MONGODB_URI=mongodb://localhost:27017/nexus_prod

# JWT Security Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_512_bits_for_hs512
JWT_EXPIRATION=86400000

# Server Configuration
BASE_URL=http://localhost:8080
PORT=8080

# Stripe Payment Configuration (Use your actual Stripe keys)
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# Socket.IO Configuration
SOCKETIO_HOST=localhost
SOCKETIO_PORT=9092

# Payment Settings
DEFAULT_CURRENCY=USD
TRANSACTION_FEE=0.029
FIXED_FEE=0.30

# Email Configuration (if needed)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Logging Configuration
LOGGING_LEVEL=INFO

# Production Settings
SPRING_PROFILES_ACTIVE=prod